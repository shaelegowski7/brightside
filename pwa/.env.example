# The deployed FastAPI backend's base URL.
VITE_API_BASE_URL=https://your-backend.up.railway.app

# Supabase project this PWA authenticates against. Both are safe to expose
# client-side by design (the opposite security posture from the old
# shared-secret model this replaced) -- the anon key is meant to be
# public, and this app stores no data in Supabase's own Postgres (auth
# only, see backend/app/auth.py), so there are no RLS policies riding on
# either value being secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
